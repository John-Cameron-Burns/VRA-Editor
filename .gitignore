# Python
__pycache__/
*.pyc
.venv/

# PyInstaller build output (see packaging/VRA_Editor.spec) and the final
# packaged installers/apps/executables the build_*.{bat,command,sh}
# scripts at the repo root (and packaging/build_linux_deb.sh) produce.
/build/
/dist/
/distributions/

# Personal IDE config -- not part of the app, and not the same between
# any two contributors' machines.
/.idea/

# Real media files dropped into the working folders during use (personal
# photos, scans, ...) -- not sample data, never meant to be tracked.
# Uppercase variants included explicitly since git's case-sensitivity for
# ignore patterns follows core.ignorecase, which isn't true on every platform.
/data/ingest/**/*.tif
/data/ingest/**/*.TIF
/data/ingest/**/*.tiff
/data/ingest/**/*.TIFF
/data/ingest/**/*.jpg
/data/ingest/**/*.JPG
/data/ingest/**/*.jpeg
/data/ingest/**/*.JPEG
/data/ingest/**/*.png
/data/ingest/**/*.PNG
/data/ingest/**/*.pxm
/data/ingest/**/*.PXM
/data/media/
